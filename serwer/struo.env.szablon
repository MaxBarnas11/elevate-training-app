# Ustawienia Struo na serwerze. Skopiuj jako /etc/struo.env, potem: sudo chmod 600 /etc/struo.env
# To NIE sa sekrety (sekrety logowania sa osobno w .streamlit/secrets.toml), ale adresy e-mail tez trzymamy poza gitem.
STRUO_LOGOWANIE=1
STRUO_WLASCICIEL=twoj-adres@gmail.com
# Zaproszeni znajomi (po przecinku), na start zostaw puste
STRUO_DOZWOLONE=

# Hasła i dane logowania
.env

# Środowisko wirtualne (nie wrzucamy go do gita)
venv/
.venv/

# Pliki tymczasowe Pythona
__pycache__/
*.pyc

# Baza danych z treningami (Twoje prywatne dane)
*.db

# Pliki tymczasowe do podmiany (podmien.bat)
*_NOWA.py

# Plik tworzony automatycznie przez aplikacje (komponent naglowka profilu)
kod/komponenty/

# Nazwa tematu powiadomień ntfy (działa jak hasło)
ntfy_temat.txt

# Zapamiętane logowanie do Garmina (tokeny dają dostęp do konta) i przerwa po błędzie
.garmin_tokeny/
.garmin_blokada

# Sekrety logowania Google (client_secret, cookie_secret) - NIGDY do gita.
# Wzorzec secrets* lapie tez pliki po zmianie nazwy (secrets.toml.off, secrets.off.toml, secrets.off).
secrets*

# Dane innych uzytkownikow (po jednym folderze na osobe) i kopie zapasowe
dane/
kopie/

# Instancje gosci i ich lista
goscie/
goscie.txt

# Eksporty i kopie robocze
*.bak
*.sqlite
*.sqlite3
*-journal
*.db-wal
*.db-shm

narzedzia/wynik_*.txt